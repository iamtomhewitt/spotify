{
  "name": "spotify",
  "version": "2.0.1",
  "description": "API for my spotify to power my website",
  "author": "Tom Hewitt",
  "scripts": {
    "build": "rm -rf dist && tsc -b && cp package.json dist/package.json && cd dist && npm i --omit=dev",
    "deploy": "sls deploy --aws-profile tom",
    "lint-fix": "iamtomhewitt-linter --sourceFolder=./ --type=typescript --fix",
    "prepare": "husky",
    "release": "iamtomhewitt-releaser && npm run build && npm run deploy"
  },
  "dependencies": {
    "@iamtomhewitt/error": "3.1.2",
    "@iamtomhewitt/http": "3.1.2",
    "@vercel/og": "0.11.1",
    "dotenv": "17.4.2",
    "get-image-colors": "4.0.1",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@iamtomhewitt/linter": "3.1.2",
    "@iamtomhewitt/releaser": "3.1.2",
    "@tsconfig/node24": "24.0.4",
    "@types/get-image-colors": "4.0.5",
    "@types/node": "25.2.3",
    "@types/react": "19.2.17",
    "husky": "9.1.7",
    "serverless": "3.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}